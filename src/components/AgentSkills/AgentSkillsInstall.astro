---
import { Code } from "astro:components";
import { agentSkills } from "virtual:pigment-config";
import { codePanelsStyles } from "../CodePanels";
import { Icon } from "../Icon";
import Tab from "../Tabs/Tab.astro";
import Tabs from "../Tabs/Tabs.astro";
import { getAgent, installMethods, resolveInstallMethod } from "../../utils/agentSkills";
import { adaptiveCodeTheme } from "../../themes/adaptive-code-theme";
import styles from "./styles.module.css";

if (!agentSkills) {
  throw new Error(
    "[astro-pigment] <AgentSkillsInstall /> needs the `agentSkills` integration option.",
  );
}

type Props = {
  /** Install one skill instead of all of them. */
  skill?: string;
};

const { skill } = Astro.props;
if (skill !== undefined && !agentSkills.skills.some(({ name }) => name === skill)) {
  throw new Error(`[astro-pigment] <AgentSkillsInstall /> got unknown skill "${skill}".`);
}

const agents = agentSkills.agents.map((id) => ({
  ...getAgent(id),
  methods: installMethods(id, agentSkills, skill ?? null),
}));
const [firstAgent] = agents;
if (!firstAgent) throw new Error("[astro-pigment] agentSkills.agents must not be empty.");
const defaultMethod = resolveInstallMethod(firstAgent.methods, "");
---

<x-agent-skills-install class:list={[codePanelsStyles.wrapper, styles.root]} skill={skill}>
  <div class:list={[codePanelsStyles.tabs, styles.bar]}>
    {
      agents.map((agent, i) => (
        <Tabs
          value={agent.methods[0]?.id ?? ""}
          class={styles.methods}
          data-ref="methodTabs"
          aria-label="Install method"
          data-agent={agent.id}
          hidden={i !== 0}
        >
          {agent.methods.map((method) => (
            <Tab value={method.id} class={codePanelsStyles.tab}>
              {method.label}
            </Tab>
          ))}
        </Tabs>
      ))
    }
    <div class={styles.agent}>
      <select class={styles.agentSelect} data-ref="agentSelect" aria-label="Agent">
        {agents.map((agent) => <option value={agent.id}>{agent.label}</option>)}
      </select>
      <Icon name="chevron-down" size={12} class={styles.chevron} aria-hidden="true" />
    </div>
  </div>
  <div class={styles.panel}>
    {
      agents.map((agent) =>
        agent.methods.map((method) => (
          <div
            data-ref="commands"
            data-agent={agent.id}
            data-method={method.id}
            hidden={agent !== firstAgent || method.id !== defaultMethod.id}
          >
            <Code code={method.command} lang="shellscript" theme={adaptiveCodeTheme} />
          </div>
        )),
      )
    }
  </div>
</x-agent-skills-install>

<script src="./components.ts"></script>
