---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  clientRouter,
  docs,
  githubUrl,
  logo,
  meta,
  search,
  siteConfig,
  themePicker,
} from "virtual:pigment-config";
import "../../styles/index.css";
import type { AlternateLink, NavItem } from "../../types";
import { getHref, isActiveHref, isCurrentHref } from "../../utils/urls";
import { hasMobilePopover } from "../MobilePopover";
import CodeBlockWrapper from "../CodeBlockWrapper/CodeBlockWrapper.astro";
import Footer from "../Footer/Footer.astro";
import Icon from "../Icon/Icon.astro";
import ThemePicker from "../ThemePicker/ThemePicker.astro";
import ThemePickerScript from "../ThemePicker/ThemePickerScript.astro";
import ThemeStyle from "../ThemeStyle/ThemeStyle.astro";
import LayoutFavicons from "./LayoutFavicons.astro";
import LayoutMeta from "./LayoutMeta.astro";
import LayoutMobileTriggers from "./LayoutMobileTriggers.astro";

import { Search } from "../Search";
import { ThemeScript, ThemeToggle } from "../ThemeToggle";
import styles from "./styles.module.css";

type Props = {
  title: string;
  description?: string;
  navLinks?: NavItem[];
  alternate?: AlternateLink[];
};

// Astro.slots.has() reports true for a conditional slot ({cond && <el slot="x"/>}),
// because the compiler hoists the condition inside the slot function. Rendering it
// is the only reliable emptiness check.
const renderSlot = async (name: string): Promise<string> => {
  const html: unknown = await Astro.slots.render(name);
  return typeof html === "string" ? html : "";
};

const { title, description, navLinks = docs.navLinks, alternate } = Astro.props;
const [sidebarHtml, sidebarRightHtml] = await Promise.all([
  renderSlot("sidebar"),
  renderSlot("sidebar-right"),
]);
const showSidebar = sidebarHtml.trim() !== "";
const showSidebarRight = sidebarRightHtml.trim() !== "";
// The slotted sidebars own their mobile popovers and register them while rendering above,
// so only read the registry after those awaits.
const hasMobileNav = hasMobilePopover(Astro.locals, "nav");
const hasMobileToc = hasMobilePopover(Astro.locals, "toc");
const mdAlternate = alternate?.find((a) => a.type === "text/markdown");
const mdAbsoluteUrl = mdAlternate ? new URL(mdAlternate.href, Astro.url).href : undefined;

const author = siteConfig.author;
const isMainPage = isCurrentHref(Astro, "");
const resolvedTitle = isMainPage
  ? meta.mainPageTitle
  : meta.titleSuffix
    ? `${title} | ${meta.titleSuffix}`
    : title;
const resolvedDescription = description ?? siteConfig.project.description;
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <LayoutFavicons />
    <LayoutMeta title={resolvedTitle} description={resolvedDescription} alternate={alternate} />
    <link rel="sitemap" href={getHref("sitemap-index.xml")} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <ThemeStyle />
    {clientRouter && <ClientRouter />}
    <ThemeScript />
    {themePicker && <ThemePickerScript />}
    <script src="./scripts.ts"></script>
    <slot name="head-extra" />
  </head>
  <body class:list={[styles.container, showSidebar && showSidebarRight && styles.wideLayout]}>
    {
      mdAbsoluteUrl && (
        <div class="visually-hidden" aria-hidden="true">
          A Markdown version of this page is available at {mdAbsoluteUrl} — optimized for AI and LLM
          tools.
        </div>
      )
    }
    <a href="#main-content" class={styles.skipLink}>Skip to main content</a>
    <x-sticky-header role="banner">
      <nav class:list={styles.nav}>
        <a href={getHref("")} class={styles.logo} aria-label={siteConfig.project.name}>
          <slot name="logo">
            {
              logo ? (
                <Fragment set:html={logo} />
              ) : (
                <span class={styles.logoText}>{siteConfig.project.name}</span>
              )
            }
          </slot>
        </a>
        {
          navLinks.length > 0 && (
            <div class:list={[styles.links, styles.primaryNav]} role="menubar" focusgroup="wrap">
              {navLinks.map((item) => (
                <a
                  role="menuitem"
                  href={getHref(item.href)}
                  class:list={[styles.link, isActiveHref(Astro, item.href) && styles.active]}
                  {...item.attrs}
                >
                  {item.label}
                </a>
              ))}
            </div>
          )
        }
        <div class:list={[styles.links, styles.extraNav]} role="menubar" focusgroup="wrap">
          {search && <Search role="menuitem" />}
          <ThemeToggle role="menuitem" />
          {
            author && (
              <a
                href={author.url}
                class:list={[styles.link, styles.square]}
                aria-label={author.name}
                role="menuitem"
              >
                {author.icon ? (
                  <Fragment set:html={author.icon} />
                ) : author.url.includes("x.com") ? (
                  <Icon name="x" />
                ) : null}
              </a>
            )
          }
          <a
            href={githubUrl}
            class:list={[styles.link, styles.square]}
            aria-label="GitHub"
            role="menuitem"
          >
            <Icon name="github" />
          </a>
        </div>
      </nav>
    </x-sticky-header>
    <div class={styles.main}>
      {
        showSidebar && (
          <aside class={styles.sidebar}>
            <Fragment set:html={sidebarHtml} />
          </aside>
        )
      }
      <main id="main-content" class={styles.content}>
        <slot />
      </main>
      {
        showSidebarRight && (
          <aside class={styles.sidebarRight}>
            <Fragment set:html={sidebarRightHtml} />
          </aside>
        )
      }
    </div>
    <Footer class={styles.footer}>
      <slot name="footer-extra" slot="extra" />
    </Footer>
    {
      (hasMobileNav || hasMobileToc) && (
        <LayoutMobileTriggers nav={hasMobileNav} toc={hasMobileToc} />
      )
    }
    <CodeBlockWrapper />
    {
      themePicker && (
        <ThemePicker
          class:list={[styles.themePicker, hasMobileNav && hasMobileToc && styles.shifted]}
        />
      )
    }
  </body>
</html>
<script>
  import { define } from "nanotags";
  import { atom } from "nanostores";
  import styles from "./styles.module.css";

  define("x-sticky-header", (ctx) => {
    const $scrolled = atom(window.scrollY > 0);

    ctx.on(window, "scroll", () => $scrolled.set(window.scrollY > 0), { passive: true });
    ctx.effect($scrolled, (scrolled) => {
      ctx.host.classList.toggle(styles.scrolled, scrolled);
    });
  });
</script>
