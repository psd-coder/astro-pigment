    "./edge/vercel": "./src/edge/vercel.ts",
    "./edge/netlify": "./src/edge/netlify.ts",
    "./edge/cloudflare": "./src/edge/cloudflare.ts",
    "./styles/*": "./src/styles/*",
    "./types": "./src/types.ts",
    "./stylelint.config": "./stylelint.config.js",
    "./browserslist": "./.browserslistrc"
