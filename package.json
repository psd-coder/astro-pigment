    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "satori": "^0.29.0",
    "satteri": "^0.9.5",
    "typed-channel": "^0.10.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
