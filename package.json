    "@types/mdast": "^4.0.4",
    "@vercel/functions": "^3.7.6",
    "astro": "^7.1.3",
    "nanostores": "^1.4.1",
    "nanotags": "^0.15.2",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
